# Copy this file to .env.local (already gitignored — see .gitignore's
# `.env*.local` entry) and set your own value for local development.
# Expo automatically inlines EXPO_PUBLIC_* variables into the JS bundle
# at build time — no extra config needed.
#
# If unset, the app falls back to the production API
# (https://powergen-api-wrr1.onrender.com) — see services/api.ts.

# Point this at your local backend's LAN IP when developing against a
# machine on the same WiFi network as your device/emulator, e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.137:5000
EXPO_PUBLIC_API_URL=https://powergen-api-i2t7.onrender.com
